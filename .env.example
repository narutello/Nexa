# ─── Database ───────────────────────────────────────────────
# Postgres connection string (use the pooled URL on Vercel / Neon).
# Without this, the app falls back to local PGLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ─── Better Auth (required in production) ───────────────────
# Long random secret used to sign sessions / cookies (≥ 32 chars).
BETTER_AUTH_SECRET=replace_with_a_long_random_string

# Public origin of the app (must match the browser URL).
BETTER_AUTH_URL=https://your-app.vercel.app

# ─── Auth UI (optional) ─────────────────────────────────────
# Set to "true" to force the auth UI on in environments where it is off by default.
# VITE_AUTH_ENABLED=true

# ─── OAuth / Grok broker (optional) ─────────────────────────
# Only needed if you use Sign in with Grok (or similar) instead of email/password alone.
# GROK_AUTH_ISSUER=https://your-issuer.example
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
